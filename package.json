    "test:live": "node scripts/smoke-crossref.mjs",
    "build:icons": "node scripts/build-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "leaflet": "1.9.4",
    "lucide-static": "^1.75.0",
    "prettier": "^3.10.1"
  }
}
