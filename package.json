{
  "name": "ancient-egypt-research-explorer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An integrated ancient Egyptian research workspace using Crossref metadata.",
  "scripts": {
    "dev": "python3 scripts/serve.py",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-syntax.mjs",
